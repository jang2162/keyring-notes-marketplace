# Marketplace server settings for compose.yaml. Copy this file to .env and edit it.

# Host folder with your packages, laid out as <scope>/<name>/<version>/.
# It is mounted read-only at /srv/market/packages.
MARKET_PACKAGES=./packages

# Host address and port. Do not open them to the internet: serve over https behind a reverse proxy.
MARKET_BIND=127.0.0.1
MARKET_PORT=8080

# How often (seconds) index.json is rebuilt. New versions appear this long after you add them.
MARKET_REBUILD_SECONDS=60

# Repository name (the name in index.json). The app shows it in the repository list.
MARKET_NAME=Keyring Notes
